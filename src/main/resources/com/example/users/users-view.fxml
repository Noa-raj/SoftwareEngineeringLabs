<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400.0" prefWidth="602.0" spacing="16.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="LoginController">
    <padding>
        <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
    </padding>
        <Label text="Hello!" />
        <HBox prefHeight="18.0" prefWidth="554.0">
                <Label prefHeight="46.0" prefWidth="96.0" text="Username:" wrapText="true" />
                <TextField fx:id="nameField" prefHeight="26.0" prefWidth="441.0" />
        </HBox>
        <HBox prefHeight="0.0" prefWidth="554.0">
                <Label prefHeight="57.0" prefWidth="96.0" text="Password:" wrapText="true" />
                <TextField fx:id="passField" prefHeight="26.0" prefWidth="444.0" />
        </HBox>
   <Label fx:id="errorLabel" text="Invalid username or password" textFill="RED" visible="false" />
        <Button mnemonicParsing="false" onAction="#click" text="Log in" />
</VBox>
